NavButton/colors/font_hover_color = Color(1, 1, 1, 1)
NavButton/colors/font_pressed_color = Color(0.85, 0.85, 0.8, 1)
NavButton/colors/font_disabled_color = Color(0.7, 0.7, 0.65, 0.5)

