[gd_resource type="Theme" load_steps=44 format=3]

; Pixel-art UI theme.
;
; Three rules hold the look together, and new styles should follow them:
;   1. every corner radius is 0 -- pixel art has no smooth curves
;   2. anti_aliasing is off on every box, so edges land on whole pixels
;   3. borders are whole pixels (1px for controls, 2px for panels)
;
; Typography is the bitmap font in assets/fonts/, which only looks right
; at its native 10px or an exact integer multiple, so the only sizes used
; anywhere are 10 (body), 20 (titles) and 30 (main menu hero).
;
; Godot drops these comments if the theme is ever resaved from the editor
; inspector, so prefer editing this file by hand.

[ext_resource type="FontFile" uid="uid://cu1tnsiwbogoh" path="res://assets/fonts/pixel_font.fnt" id="1_pixel_font"]

