[resource]
default_font = ExtResource("1_pixel_font")
default_font_size = 10

Panel/styles/panel = SubResource("StyleBoxFlat_panel")

Button/styles/normal = SubResource("StyleBoxFlat_button_normal")
Button/styles/hover = SubResource("StyleBoxFlat_button_hover")
Button/styles/pressed = SubResource("StyleBoxFlat_button_pressed")
Button/styles/disabled = SubResource("StyleBoxFlat_button_disabled")
Button/colors/font_color = Color(1, 1, 1, 1)
Button/colors/font_hover_color = Color(1, 1, 1, 1)
Button/colors/font_pressed_color = Color(0.9, 0.9, 0.9, 1)
Button/colors/font_disabled_color = Color(0.85, 0.85, 0.85, 0.8)

PrimaryButton/base_type = &"Button"
PrimaryButton/styles/normal = SubResource("StyleBoxFlat_primary_normal")
PrimaryButton/styles/hover = SubResource("StyleBoxFlat_primary_hover")
PrimaryButton/styles/pressed = SubResource("StyleBoxFlat_primary_pressed")
PrimaryButton/styles/disabled = SubResource("StyleBoxFlat_primary_disabled")
PrimaryButton/colors/font_color = Color(1, 1, 1, 1)
PrimaryButton/colors/font_hover_color = Color(1, 1, 1, 1)
PrimaryButton/colors/font_pressed_color = Color(0.95, 0.95, 0.9, 1)
PrimaryButton/colors/font_disabled_color = Color(0.85, 0.85, 0.85, 0.8)

