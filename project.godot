; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Fishermans Island"
run/main_scene="res://scenes/main_menu/MainMenu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Economy="*res://scripts/economy.gd"
Album="*res://scripts/album.gd"
WorldClock="*res://scripts/world_clock.gd"
SaveManager="*res://scripts/save_manager.gd"
Inventory="*res://scripts/inventory.gd"
MetaProgress="*res://scripts/meta_progress.gd"
PotionManager="*res://scripts/potion_manager.gd"
ShopRotation="*res://scripts/shop_rotation.gd"
DevConsole="*res://scenes/ui/DevConsole.tscn"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://assets/ui_theme.tres"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
